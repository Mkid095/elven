# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# --- Deriv Trading API credentials (registered app) ---
# The Secrets Gradle Plugin reads .env (real values) and falls back to .env.example
# (defaults) when no .env exists, exposing each key as BuildConfig.<KEY>.

# DERIV_APP_ID: Your Deriv application id. Used in the public market-data WebSocket
# handshake (wss://ws.derivws.com/websockets/v3?app_id=<id>) and required on authenticated
# requests as the Deriv-App-ID header. Default is Deriv's public app id; override in .env
# with your registered id (App name: elven).
# IMPORTANT: Per Deriv OAuth docs, the OAuth client id is the SAME value as this app id.
DERIV_APP_ID=34EBfV9KENCCnCcjlA5Vf

# DERIV_API_TOKEN: Personal Access Token (PAT) for authenticated endpoints
# (balance, accounts, trading). The build-safe default is the sentinel "not-configured";
# override in .env with a real PAT.
# Generate one from the Deriv app dashboard, scoped to the account you intend to use.
# NOTE: DEV-ONLY fallback; the production path is Deriv OAuth (per-user access token).
DERIV_API_TOKEN=not-configured

# DERIV_OAUTH_CLIENT_ID: the `elvenoauth` Deriv app id. This is NOT the same as
# DERIV_APP_ID (which is the `elven` trading app). Deriv only treats them as equal when a
# single registered app serves both roles; when they differ this MUST be set explicitly,
# because the fallback to DERIV_APP_ID would send the wrong client_id and Deriv rejects it.
# Deriv OAuth docs: https://developers.deriv.com/docs/intro/oauth/
DERIV_OAUTH_CLIENT_ID=34EGMwG2vIS9204qjX4q6
# DERIV_OAUTH_REDIRECT_URI: the EXACT registered redirect URI (must match Deriv dashboard).
DERIV_OAUTH_REDIRECT_URI=https://elven.nextmavens.com/oauth/callback
# DERIV_OAUTH_SCOPES: scopes requested from Deriv at the authorize step.
#
# Deriv REJECTS the whole authorization request with `invalid_request` if the app is not
# registered for a requested scope — there is no runtime fallback, because the error is
# returned to the browser before the app ever sees a callback. Only request scopes the
# `elvenoauth` app is actually configured for.
#
# `trade`            — always allowed; required for placing orders.
# `openid`           — required for FIDScript cross-device sync (it yields the id_token that
#                       POST /runtime/oauth/id_token verifies). MUST first be enabled on the
#                       app in the Deriv dashboard. Until then, leave it off — requesting it
#                       without permission breaks login entirely.
# `account_manage`   — account creation/management.
# `payment`          — payment agent deposits/withdrawals.
DERIV_OAUTH_SCOPES=trade

# FIDScript (self-hosted InstantDB) app id. Public client identifier, not a secret.
INSTANT_APP_ID=ce219821-50b6-4ffd-9e9f-d6ec44e6b7e9
