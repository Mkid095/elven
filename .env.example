# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# --- Deriv Trading API credentials (registered app) ---
# The Secrets Gradle Plugin reads .env (real values) and falls back to .env.example
# (defaults) when no .env exists, exposing each key as BuildConfig.<KEY>.

# DERIV_APP_ID: Your Deriv application id. Used in the public market-data WebSocket
# handshake (wss://ws.derivws.com/websockets/v3?app_id=<id>) and required on authenticated
# requests as the Deriv-App-ID header. Default is Deriv's public app id; override in .env
# with your registered id (App name: elven).
DERIV_APP_ID=1089

# DERIV_API_TOKEN: Personal Access Token (PAT) for authenticated endpoints
# (balance, accounts, trading). The build-safe default is the sentinel "not-configured";
# override in .env with a real PAT.
# Generate one from the Deriv app dashboard, scoped to the account you intend to use.
# NOTE: DEV-ONLY fallback; the production path is Deriv OAuth (per-user access token).
DERIV_API_TOKEN=not-configured

# DERIV_OAUTH_CLIENT_ID: OAuth client id registered for this app. Keep the sentinel
# "not-configured" to fall back to the dev PAT. Set a real client id + a registered
# Redirect URI + scopes to enable production multi-user OAuth login.
DERIV_OAUTH_CLIENT_ID=not-configured
# DERIV_OAUTH_REDIRECT_URI: the EXACT registered redirect URI.
DERIV_OAUTH_REDIRECT_URI=not-configured
# DERIV_OAUTH_SCOPES: requested scopes, e.g. "trade" / "trade,account_manage".
DERIV_OAUTH_SCOPES=trade

# --- InstantDB / FIDScript (cross-device, user-scoped persistence) ---
# FIDScript app id created via the instant-self MCP. Keep the sentinel "not-configured"
# until you create the backend app, then set your real app id to enable cross-device sync.
INSTANT_APP_ID=not-configured
INSTANT_API_BASE=https://apiinstant.fidscript.com
