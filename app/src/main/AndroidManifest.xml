<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        The foreground service is what keeps the bot trading when the app is not in front.

        Without it the OS is free to freeze the app the moment it is backgrounded: the sockets stop
        receiving, an open contract is never settled, and the stake the user already paid for is
        never recorded. With it, the process stays alive and visible as a notification, and the
        trading loop — which lives in TradingRuntime, outside the Activity — carries on.

        FOREGROUND_SERVICE_DATA_SYNC is the type this service runs under (Android 14+ requires the
        type to be declared in both the permission and the manifest).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Deriv OAuth redirect receiver.

            Primary path: verified Android App Link. Deriv redirects to
            https://elven.nextmavens.com/oauth/callback; Android verifies the domain via
            /.well-known/assetlinks.json and opens this activity directly, bypassing the
            browser entirely.

            Fallback: the custom scheme. If domain verification fails (stale signing
            fingerprint, app not installed), the browser lands on elven-web's callback.html,
            which forwards the query string to elven://oauth/callback.

            BOTH filters are required. Removing the scheme filter makes a verification failure
            unrecoverable — the user is stranded on a web page that cannot reach the app.
        -->
        <activity
            android:name=".DerivOAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- Primary: verified App Link -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="elven.nextmavens.com"
                    android:pathPrefix="/oauth/callback"
                    android:scheme="https" />
            </intent-filter>

            <!-- Fallback: custom scheme, mirrors elven-web/public/oauth/callback.html -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:path="/callback"
                    android:scheme="elven" />
            </intent-filter>
        </activity>

        <!--
            Keeps the process alive and visible while the bot trades. Not exported: nothing outside
            the app has any business starting or stopping the user's trading session.

            foregroundServiceType="dataSync" is required on Android 14+ and must match the
            FOREGROUND_SERVICE_DATA_SYNC permission above.
        -->
        <service
            android:name=".domain.TradingService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
    </application>

</manifest>
